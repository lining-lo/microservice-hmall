target/
*.class
*.jar
*.war

# Spring Boot 运行日志（application.yaml: logging.file.path: logs/hm-service）
logs/

# ========== IDE ==========
.idea/
*.iml
*.iws
*.ipr
.vscode/

# ========== 操作系统 ==========
.DS_Store
Thumbs.db
desktop.ini

# ========== Nginx（Windows 版）运行时产物 ==========
# 目录本身必须留着（nginx 不存在的目录不会自己创建，会直接 emerg 退出），
# 所以只忽略目录里的文件，用 .gitkeep 占位把空目录提交上去。
!hmall-nginx/logs/
hmall-nginx/logs/*
!hmall-nginx/logs/.gitkeep
!hmall-nginx/temp/
hmall-nginx/temp/*
!hmall-nginx/temp/.gitkeep